# ── Bắt buộc ──
TOKEN=your_discord_bot_token

# ── Giữ file JSON, auto-sync lên GitHub làm storage xa (Render free) ──
# Bật sync: để "true". Máy dev local: để trống hoặc "false".
DATA_SYNC_ENABLED=false
# Personal Access Token (https://github.com/settings/tokens) → quyền repo (contents:write)
GITHUB_TOKEN=
# "owner/repo" của repo chứa bot, ví dụ:
GITHUB_REPO=HuyHoagnn/LootBoxRoleBot

# ── Tùy chọn ──
CLIENT_ID=
PORT=3000
